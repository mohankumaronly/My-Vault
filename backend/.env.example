# ── Runtime ──────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://app_user:change_me@localhost:5432/my_vault

# ── Frontend origin (CORS) ───────────────────────────────
CLIENT_ORIGIN=http://localhost:5173

# ── Session ──────────────────────────────────────────────
SESSION_SECRET=replace_with_64_byte_hex_random
SESSION_DURATION_MINUTES=30
COOKIE_NAME=my_vault_session
COOKIE_SECURE=false          # true in production (HTTPS)
COOKIE_SAME_SITE=strict

# ── Test API key (Postman / Newman) ─────────────────────
# When TEST_MODE=true, requests carrying this key bypass CSRF
# and receive relaxed rate limits. NEVER enable in production.
TEST_MODE=true
TEST_API_KEY=test_sk_generate_a_random_hex_string_here

# ── Self-hosted master key ───────────────────────────────

# The single key that unlocks the dashboard. On startup the backend

# auto-provisions the vault from this value. Type the same value in the

# browser to unlock. Minimum 8 characters. Changing it later requires

# clearing the vault row so it can be re-provisioned.
MASTER_KEY=change-this-to-your-own-secret-master-key