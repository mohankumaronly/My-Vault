    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "hash-wasm": "^4.12.0",
    "helmet": "^8.1.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^26.6.6",
    "prisma": "^6.5.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
