{
  "info": {
    "name": "My-Vault API",
    "description": "Master-key-only zero-knowledge password manager.\n\nQUICK START (works out of the box):\n- A vault has already been provisioned on the dev database using the exact values in the collection variables (salt, wrappedVaultKey, keyNonce, authVerifier).\n- With TEST_MODE=true, the X-Test-API-Key header bypasses CSRF and rate limits.\n- Just run the requests in order: 00 Health -> 01 Metadata -> 03 Unlock -> 05 Create -> 06 List -> 07 Get -> 08 Update -> 09 Delete -> 10 Lock.\n- Step 02 (Setup) will return 409 because the vault already exists - this is expected and correct.\n\nSTARTING FROM A FRESH DATABASE:\n1. Clear existing vault data or use a new DATABASE_URL.\n2. Run `node scripts/generate-test-verifier.js` in backend/ to produce a fresh base64 authVerifier + envelope.\n3. Paste the printed values into the collection variables (authVerifier, salt, wrappedVaultKey, keyNonce).\n4. Run 02 Setup (returns 201 + csrfToken), then continue.\n\nAll endpoints are under {{baseUrl}} = http://localhost:5000/api/v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api/v1" },
    { "key": "testApiKey", "value": "test_sk_a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90" },
    { "key": "authVerifier", "value": "cKB5Z3KBeRXb7aychoKCdcNwUwo7GtKaTUTzqBc/gsc=" },
    { "key": "salt", "value": "yCJbcoG6bqJ27g9dHMWGZw==" },
    { "key": "wrappedVaultKey", "value": "QlNFOTV0fkbQnvEQRIPRjhjw7FOnAPsB+Q0s5v3j8bUjOhYrqelWTNXcKRWUs5vX" },
    { "key": "keyNonce", "value": "RlzOaJDPCMnfwKzh" },
    { "key": "credentialId", "value": "" },
    { "key": "csrfToken", "value": "" }
  ],
  "item": [
    {
      "name": "00 · Health check",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('success is true', () => pm.expect(pm.response.json().success).to.be.true);"
            ]
          }
        }
      ],
      "request": { "method": "GET", "url": "{{baseUrl}}/health" }
    },
    {
      "name": "01 · Get vault metadata",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns 200 or 404', () => pm.expect([200, 404]).to.include(pm.response.code));",
              "if (pm.response.code === 200) {",
              "  const d = pm.response.json().data;",
              "  pm.test('metadata has salt + wrapped key', () => {",
              "    pm.expect(d.salt).to.be.a('string');",
              "    pm.expect(d.wrappedVaultKey).to.be.a('string');",
              "    pm.expect(d.kdfAlgorithm).to.eql('ARGON2ID');",
              "  });",
              "}"
            ]
          }
        }
      ],
      "request": { "method": "GET", "url": "{{baseUrl}}/vault/metadata" }
    },
    {
      "name": "02 · Setup vault (only if 404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns 201 or 409 (if vault exists)', () => pm.expect([201, 409]).to.include(pm.response.code));",
              "if (pm.response.code === 201) {",
              "  const d = pm.response.json().data;",
              "  pm.test('setup returns csrfToken', () => pm.expect(d.csrfToken).to.be.a('string'));",
              "  pm.collectionVariables.set('csrfToken', d.csrfToken);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Test-API-Key", "value": "{{testApiKey}}" }
        ],
        "url": "{{baseUrl}}/vault/setup",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"kdfAlgorithm\": \"ARGON2ID\",\n  \"kdfParameters\": { \"memoryKiB\": 65536, \"iterations\": 3, \"parallelism\": 4, \"outputLength\": 64 },\n  \"salt\": \"{{salt}}\",\n  \"keyEncryptionAlgo\": \"AES-256-GCM\",\n  \"wrappedVaultKey\": \"{{wrappedVaultKey}}\",\n  \"keyNonce\": \"{{keyNonce}}\",\n  \"authVerifier\": \"{{authVerifier}}\",\n  \"encryptionVersion\": 1\n}"
        }
      }
    },
    {
      "name": "03 · Unlock vault",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns 200 or 401', () => pm.expect([200, 401]).to.include(pm.response.code));",
              "if (pm.response.code === 200) {",
              "  const d = pm.response.json().data;",
              "  pm.test('unlock returns csrfToken', () => pm.expect(d.csrfToken).to.be.a('string'));",
              "  pm.collectionVariables.set('csrfToken', d.csrfToken);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Test-API-Key", "value": "{{testApiKey}}" }
        ],
        "url": "{{baseUrl}}/vault/unlock",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"authVerifier\": \"{{authVerifier}}\"\n}"
        }
      }
    },
    {
      "name": "04 · Get CSRF token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns 200 or 401', () => pm.expect([200, 401]).to.include(pm.response.code));",
              "if (pm.response.code === 200) {",
              "  pm.collectionVariables.set('csrfToken', pm.response.json().data.csrfToken);",
              "}"
            ]
          }
        }
      ],
      "request": { "method": "GET", "url": "{{baseUrl}}/csrf" }
    },
    {
      "name": "05 · Create credential",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns 201 or 401', () => pm.expect([201, 401]).to.include(pm.response.code));",
              "if (pm.response.code === 201) {",
              "  const d = pm.response.json().data;",
              "  pm.collectionVariables.set('credentialId', d.id);",
              "  pm.test('credential has ciphertext + recordVersion', () => {",
              "    pm.expect(d.ciphertext).to.be.a('string');",
              "    pm.expect(d.recordVersion).to.eql(1);",
              "  });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Test-API-Key", "value": "{{testApiKey}}" }
        ],
        "url": "{{baseUrl}}/credentials",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ciphertext\": \"QkFTRTY0X1RFU1RfQ0lQSEVSVEVYVA==\",\n  \"nonce\": \"dGVzdG5vbmNlMTI=\",\n  \"encryptionVersion\": 1\n}"
        }
      }
    },
    {
      "name": "06 · List credentials",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns 200 or 401', () => pm.expect([200, 401]).to.include(pm.response.code));",
              "if (pm.response.code === 200) {",
              "  pm.test('data is an array', () => pm.expect(pm.response.json().data).to.be.an('array'));",
              "}"
            ]
          }
        }
      ],
      "request": { "method": "GET", "url": "{{baseUrl}}/credentials" }
    },
    {
      "name": "07 · Get one credential",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns 200, 401 or 404', () => pm.expect([200, 401, 404]).to.include(pm.response.code));"
            ]
          }
        }
      ],
      "request": { "method": "GET", "url": "{{baseUrl}}/credentials/{{credentialId}}" }
    },
    {
      "name": "08 · Update credential (optimistic concurrency)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns 200, 401, 404 or 409', () => pm.expect([200, 401, 404, 409]).to.include(pm.response.code));",
              "if (pm.response.code === 200) {",
              "  pm.test('recordVersion incremented', () => pm.expect(pm.response.json().data.recordVersion).to.be.greaterThan(1));",
              "}",
              "if (pm.response.code === 409) {",
              "  pm.test('409 on stale recordVersion', () => pm.expect(pm.response.json().message).to.be.a('string'));",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Test-API-Key", "value": "{{testApiKey}}" }
        ],
        "url": "{{baseUrl}}/credentials/{{credentialId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ciphertext\": \"QkFTRTY0X05FV19DSVBIRVJURVhU\",\n  \"nonce\": \"bmV3bm9uY2UxMg==\",\n  \"encryptionVersion\": 1,\n  \"expectedRecordVersion\": 1\n}"
        }
      }
    },
    {
      "name": "09 · Delete credential",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns 200, 401 or 404', () => pm.expect([200, 401, 404]).to.include(pm.response.code));"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [{ "key": "X-Test-API-Key", "value": "{{testApiKey}}" }],
        "url": "{{baseUrl}}/credentials/{{credentialId}}"
      }
    },
    {
      "name": "10 · Lock vault",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns 200 or 401', () => pm.expect([200, 401]).to.include(pm.response.code));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "X-Test-API-Key", "value": "{{testApiKey}}" }],
        "url": "{{baseUrl}}/vault/lock"
      }
    }
  ]
}
